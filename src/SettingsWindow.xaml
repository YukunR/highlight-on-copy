<Window
    x:Class="HighlightOnCopy.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Highlight on Copy"
    Width="300"
    Height="228"
    x:ClassModifier="internal"
    Background="#F5F5F7"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="#E8E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="76" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="8,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,14">

        <!--  Title row  -->
        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
            <Ellipse
                x:Name="StatusDot"
                Width="9"
                Height="9"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Fill="#4CAF50" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#1A1A1A"
                Text="Highlight on Copy" />
        </StackPanel>

        <Rectangle
            Height="1"
            Margin="0,0,0,12"
            Fill="#E0E0E0" />

        <!--  Status / Pause row  -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#555555"
                Text="状态" />
            <Button
                x:Name="TogglePauseButton"
                Grid.Column="1"
                Click="TogglePauseButton_Click"
                Content="暂停"
                Style="{StaticResource Btn}" />
        </Grid>

        <!--  Autostart row  -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#555555"
                Text="开机自启动" />
            <CheckBox
                x:Name="StartupCheckBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                Checked="StartupCheckBox_Checked"
                Foreground="#555555"
                Unchecked="StartupCheckBox_Unchecked" />
        </Grid>

        <Rectangle
            Height="1"
            Margin="0,0,0,12"
            Fill="#E0E0E0" />

        <!--  Footer: version + exit  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="#888888"
                Text="v0.1.1" />
            <Button
                Grid.Column="1"
                Background="#FDECEA"
                Click="ExitButton_Click"
                Content="退出"
                Foreground="#C62828"
                Style="{StaticResource Btn}" />
        </Grid>

    </StackPanel>
</Window>
