{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "dotnet-format",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "format",
        "highlight-on-copy.sln",
        "--no-restore",
        "--include",
        "${staged}"
      ],
      "include": [
        "**/*.cs"
      ],
      "output": "always"
    },
    {
      "name": "restage",
      "group": "pre-commit",
      "command": "git",
      "args": [
        "add",
        "${staged}"
      ],
      "include": [
        "**/*.cs"
      ],
      "output": "always"
    },
    {
      "name": "check-comment-dividers",
      "group": "pre-commit",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".husky/check-comment-dividers.ps1",
        "--Files",
        "${staged}"
      ],
      "include": [
        "**/*.cs"
      ],
      "output": "always"
    }
  ]
}
