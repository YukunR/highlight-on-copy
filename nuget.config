<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- nuget.org is needed for dotnet local tools (Husky.Net).
         <clear /> is intentionally omitted so the SDK's built-in library-packs source
         remains available for self-contained publish (resolves runtime packages). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
