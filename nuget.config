<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- No external runtime dependencies — all referenced assemblies (WinForms, UIAutomation)
         are part of the .NET Windows targeting pack bundled with the SDK.
         nuget.org is listed here only for dotnet local tools (Husky.Net). -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- Restrict nuget.org to tool packages only — project dependency resolution is unaffected. -->
    <packageSource key="nuget.org">
      <package pattern="Husky" />
      <package pattern="Microsoft.NET.ILLink*" />
      <package pattern="Microsoft.NETCore.App.Runtime*" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime*" />
      <package pattern="Microsoft.AspNetCore.App.Runtime*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
